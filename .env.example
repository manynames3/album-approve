# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PROOFALBUM_SECRET=replace-with-a-long-random-secret

# Demo storage
# Leave unset for local filesystem storage under .data.
# Set to memory only for disposable hosted demos where persistence is not expected.
# PROOFALBUM_STORAGE=memory

# Supabase production target
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM="Album Approve <proofs@example.com>"
